  "tokenColors": [
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e0e1e3",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#a6a8aa",
        "fontStyle": ""
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#e0e1e3",
        "fontStyle": ""
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#e0e1e3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#a6a8aa",
        "fontStyle": ""
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d882b9",
        "fontStyle": ""
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#83a0ee",
        "fontStyle": ""
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#edb774",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9bbc79",
        "fontStyle": ""
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6bb8bc",
        "fontStyle": ""
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ffaa90",
        "fontStyle": ""
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#ffaa90",
        "fontStyle": ""
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#d6767e",
        "fontStyle": ""
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#edb774",
        "fontStyle": ""
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#828385",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#ffaa90",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#feb143",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#ec6fc2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#92c15d"
      }
    },
    {
      "name": "markdown quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#b68cfb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.numbered",
        "markup.list.unnumbered"
      ],
      "settings": {
        "foreground": "#ffaa90"
      }
    },
    {
      "name": "markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#7b9eff"
      }
    },
    {
      "name": "diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#92c15d"
      }
    },
    {
      "name": "diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ec6372"
      }
    },
    {
      "name": "diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7b9eff"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ec6372"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#edb774"
    },
    "class": {
      "foreground": "#edb774"
    },
    "interface": {
      "foreground": "#edb774"
    },
    "enum": {
      "foreground": "#edb774"
    },
    "struct": {
      "foreground": "#edb774"
    },
    "type": {
      "foreground": "#edb774"
    },
    "typeParameter": {
      "foreground": "#edb774"
    },
    "function": {
      "foreground": "#83a0ee"
    },
    "method": {
      "foreground": "#83a0ee"
    },
    "macro": {
      "foreground": "#83a0ee"
    },
    "parameter": {
      "foreground": "#e0e1e3",
      "italic": true
    },
    "property": {
      "foreground": "#e0e1e3"
    },
    "enumMember": {
      "foreground": "#ffaa90"
    },
    "variable.readonly": {
      "foreground": "#ffaa90"
    },
    "variable.defaultLibrary": {
      "foreground": "#ffaa90"
    },
    "keyword": {
      "foreground": "#d882b9"
    },
    "string": {
      "foreground": "#9bbc79"
    },
    "number": {
      "foreground": "#ffaa90"
    },
    "regexp": {
      "foreground": "#6bb8bc"
    },
    "decorator": {
      "foreground": "#83a0ee"
    }
  }
}
