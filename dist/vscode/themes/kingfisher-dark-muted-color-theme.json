  "tokenColors": [
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cdcecf",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#a4a4a6",
        "fontStyle": ""
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#cdcecf",
        "fontStyle": ""
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#cdcecf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#a4a4a6",
        "fontStyle": ""
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c78db1",
        "fontStyle": ""
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8da1d5",
        "fontStyle": ""
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#debb90",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a1b78c",
        "fontStyle": ""
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#82b3b5",
        "fontStyle": ""
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#f6baa7",
        "fontStyle": ""
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#f6baa7",
        "fontStyle": ""
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#c28285",
        "fontStyle": ""
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#debb90",
        "fontStyle": ""
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#939495",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#fdb6a0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#e3b986",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#cd89b3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9fb985"
      }
    },
    {
      "name": "markdown quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#ad99d5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.numbered",
        "markup.list.unnumbered"
      ],
      "settings": {
        "foreground": "#fdb6a0"
      }
    },
    {
      "name": "markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#89a0dd"
      }
    },
    {
      "name": "diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#9fb985"
      }
    },
    {
      "name": "diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#c97e82"
      }
    },
    {
      "name": "diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#89a0dd"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c97e82"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#debb90"
    },
    "class": {
      "foreground": "#debb90"
    },
    "interface": {
      "foreground": "#debb90"
    },
    "enum": {
      "foreground": "#debb90"
    },
    "struct": {
      "foreground": "#debb90"
    },
    "type": {
      "foreground": "#debb90"
    },
    "typeParameter": {
      "foreground": "#debb90"
    },
    "function": {
      "foreground": "#8da1d5"
    },
    "method": {
      "foreground": "#8da1d5"
    },
    "macro": {
      "foreground": "#8da1d5"
    },
    "parameter": {
      "foreground": "#cdcecf",
      "italic": true
    },
    "property": {
      "foreground": "#cdcecf"
    },
    "enumMember": {
      "foreground": "#f6baa7"
    },
    "variable.readonly": {
      "foreground": "#f6baa7"
    },
    "variable.defaultLibrary": {
      "foreground": "#f6baa7"
    },
    "keyword": {
      "foreground": "#c78db1"
    },
    "string": {
      "foreground": "#a1b78c"
    },
    "number": {
      "foreground": "#f6baa7"
    },
    "regexp": {
      "foreground": "#82b3b5"
    },
    "decorator": {
      "foreground": "#8da1d5"
    }
  }
}
