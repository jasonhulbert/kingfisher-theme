  "tokenColors": [
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#262627",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#5a5b5c",
        "fontStyle": ""
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#262627",
        "fontStyle": ""
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#262627",
        "fontStyle": "italic"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#5a5b5c",
        "fontStyle": ""
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#97467c",
        "fontStyle": ""
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4760a8",
        "fontStyle": ""
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#905f15",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#557232",
        "fontStyle": ""
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#217579",
        "fontStyle": ""
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#71260c",
        "fontStyle": ""
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#71260c",
        "fontStyle": ""
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9a414a",
        "fontStyle": ""
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#905f15",
        "fontStyle": ""
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6b6c6d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#752000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#925e00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#a72e84",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#4c7600"
      }
    },
    {
      "name": "markdown quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#774cb4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.numbered",
        "markup.list.unnumbered"
      ],
      "settings": {
        "foreground": "#752000"
      }
    },
    {
      "name": "markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#3c5ac4"
      }
    },
    {
      "name": "diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4c7600"
      }
    },
    {
      "name": "diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ad263f"
      }
    },
    {
      "name": "diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#3c5ac4"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ad263f"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#905f15"
    },
    "class": {
      "foreground": "#905f15"
    },
    "interface": {
      "foreground": "#905f15"
    },
    "enum": {
      "foreground": "#905f15"
    },
    "struct": {
      "foreground": "#905f15"
    },
    "type": {
      "foreground": "#905f15"
    },
    "typeParameter": {
      "foreground": "#905f15"
    },
    "function": {
      "foreground": "#4760a8"
    },
    "method": {
      "foreground": "#4760a8"
    },
    "macro": {
      "foreground": "#4760a8"
    },
    "parameter": {
      "foreground": "#262627",
      "italic": true
    },
    "property": {
      "foreground": "#262627"
    },
    "enumMember": {
      "foreground": "#71260c"
    },
    "variable.readonly": {
      "foreground": "#71260c"
    },
    "variable.defaultLibrary": {
      "foreground": "#71260c"
    },
    "keyword": {
      "foreground": "#97467c"
    },
    "string": {
      "foreground": "#557232"
    },
    "number": {
      "foreground": "#71260c"
    },
    "regexp": {
      "foreground": "#217579"
    },
    "decorator": {
      "foreground": "#4760a8"
    }
  }
}
