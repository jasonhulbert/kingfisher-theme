  "tokenColors": [
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#363738",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#545557",
        "fontStyle": ""
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#363738",
        "fontStyle": ""
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#363738",
        "fontStyle": "italic"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#545557",
        "fontStyle": ""
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#80496c",
        "fontStyle": ""
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#47598b",
        "fontStyle": ""
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#7c5b2f",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#51663c",
        "fontStyle": ""
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#36686b",
        "fontStyle": ""
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#411102",
        "fontStyle": ""
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#411102",
        "fontStyle": ""
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#814449",
        "fontStyle": ""
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#7c5b2f",
        "fontStyle": ""
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#626365",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#430e00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#805922",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#85446f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#4f6834"
      }
    },
    {
      "name": "markdown quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#67518b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.numbered",
        "markup.list.unnumbered"
      ],
      "settings": {
        "foreground": "#430e00"
      }
    },
    {
      "name": "markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#445893"
      }
    },
    {
      "name": "diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4f6834"
      }
    },
    {
      "name": "diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#873f46"
      }
    },
    {
      "name": "diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#445893"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#873f46"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#7c5b2f"
    },
    "class": {
      "foreground": "#7c5b2f"
    },
    "interface": {
      "foreground": "#7c5b2f"
    },
    "enum": {
      "foreground": "#7c5b2f"
    },
    "struct": {
      "foreground": "#7c5b2f"
    },
    "type": {
      "foreground": "#7c5b2f"
    },
    "typeParameter": {
      "foreground": "#7c5b2f"
    },
    "function": {
      "foreground": "#47598b"
    },
    "method": {
      "foreground": "#47598b"
    },
    "macro": {
      "foreground": "#47598b"
    },
    "parameter": {
      "foreground": "#363738",
      "italic": true
    },
    "property": {
      "foreground": "#363738"
    },
    "enumMember": {
      "foreground": "#411102"
    },
    "variable.readonly": {
      "foreground": "#411102"
    },
    "variable.defaultLibrary": {
      "foreground": "#411102"
    },
    "keyword": {
      "foreground": "#80496c"
    },
    "string": {
      "foreground": "#51663c"
    },
    "number": {
      "foreground": "#411102"
    },
    "regexp": {
      "foreground": "#36686b"
    },
    "decorator": {
      "foreground": "#47598b"
    }
  }
}
